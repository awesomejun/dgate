{
  "dg-guard": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "dg hook --guard", "timeout": 3 }
        ]
      }
    ]
  },
  "dg-collect": {
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "dg hook --collect", "timeout": 3 }
        ]
      }
    ]
  }
}
